<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AugurACT.Core\AugurACT.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The timeline page is the plugin's own page, inlined into one file by TimelinePage. -->
    <None Include="..\AugurACT.Ui\web\**" Link="web\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
